# ChatScope backend environment
# Copy this file to .env and fill in your values.

# Required: Google Gemini API key (server-side only, never exposed to the browser).
# The server REFUSES TO START without it. To run deliberately without AI
# (analytics-only), start with ALLOW_ANALYTICS_ONLY=1 instead.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: set to 1 to boot without a Gemini key (all AI features disabled)
# ALLOW_ANALYTICS_ONLY=1

# Optional: Gemini model override (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optional: fallback model for facts/persona when the primary model is
# overloaded (503 "high demand"). Default: gemini-flash-latest (Google's
# alias that always points at an available Flash model).
# GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Optional: Groq fallback for Ask Your Chat (free key at https://console.groq.com/keys).
# When set, answers come from Groq whenever Gemini is rate-limited or overloaded.
# Facts + embeddings always stay on Gemini (they need its 1M-token context).
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: server port (default: 5000)
# PORT=5000

# Optional: allowed frontend origins, comma-separated (default: http://localhost:5173,http://localhost:4173)
# CORS_ORIGIN=http://localhost:5173

# Optional: set to 1 to log retrieval debug details (question, intent, evidence) to the server console
# DEBUG_RETRIEVAL=1

# Frontend environment (frontend/.env.local)
# Optional: backend URL if not running on http://localhost:5000
# VITE_API_URL=http://localhost:5000

# PRIVACY MODEL: there are NO accounts, sessions or sign-in keys in
# ChatScope. Chats, analytics, embeddings and retrieval learning live in
# server memory only and are wiped when the server stops. The only value
# in this file is the API key pair above — never commit them.
