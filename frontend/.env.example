# ChatScope frontend environment
# Copy this file to .env.local and fill in your values.
#
# IMPORTANT: everything prefixed with VITE_ is bundled into the JS that
# browsers download. NEVER put an API key or any secret here — the only
# supported variable is a public backend URL.

# Optional: backend URL if not running on http://localhost:5000
# (defaults are derived from the page origin; see src/lib/api.ts)
# VITE_API_URL=http://localhost:5000
